# Copy this file to environment/.env and fill in real values. NEVER commit environment/.env.
#
# These keys are read by environment/set_env.ts into environment.ts / environment.prod.ts at
# build time (npm run build-env). Empty values degrade to rate-limited / anonymous access
# rather than crashing, EXCEPT where noted. Any key shipped in a bundle is extractable, so
# rotation - not obfuscation - is the real containment control (see docs/key-rotation-runbook.md).

# TronGrid - comma-separated list; one is picked at random per request.
TRONGRID_API_KEYS=

# Etherscan V2 family - one shared key plus per-chain overrides.
ETHERSCAN_SHARED_API_KEY=
ETHERSCAN_ETH_API_KEY=
ETHERSCAN_BSC_API_KEY=
ETHERSCAN_FTM_API_KEY=
ETHERSCAN_CRO_API_KEY=

# Covalent - EVM balances / tx augmentation.
COVALENT_API_KEY=

# Assist - DID 2.0 publication.
ASSIST_API_KEY=

# Nownodes - BTC chain data (pre-existing).
NOWNODES_API_KEY=
